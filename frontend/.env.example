# SkillSwap Arena — Frontend Environment Configuration Example

# ==========================================
# 1. Local Development (Default)
# ==========================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=localhost:8000

# ==========================================
# 2. Production (Vercel)
# ==========================================
# Configure these in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://skillswap-backend-qc37.onrender.com
# VITE_WS_URL=skillswap-backend-qc37.onrender.com

# NOTE: VITE_WS_URL must be the hostname ONLY (no protocol prefix such as https:// or wss://)
# The useWebSocket hook automatically handles the protocol (ws:// for HTTP, wss:// for HTTPS).
