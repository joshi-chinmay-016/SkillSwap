# SkillSwap Arena — Root Environment Configuration Example

APP_NAME=SkillSwap Arena
ENVIRONMENT=development

# =============================================================================
# 1. Database Configuration (PostgreSQL / Supabase)
# =============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillswap
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillswap
DB_USER=postgres
DB_PASSWORD=password

# =============================================================================
# 2. Security & JWT
# =============================================================================
SECRET_KEY=replace_with_strong_production_secret_key_minimum_32_characters
JWT_SECRET=replace_with_strong_production_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# 3. CORS & Application URLs
# =============================================================================
# Local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Production:
# CORS_ORIGINS=https://<your-vercel-domain>.vercel.app
# FRONTEND_URL=https://<your-vercel-domain>.vercel.app
# FRONTEND_AUTH_CALLBACK_URL=https://<your-vercel-domain>.vercel.app/auth/callback

# =============================================================================
# 4. Redis Infrastructure (Render Redis / Local)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_CACHE_DEFAULT_TTL=300
REDIS_PRESENCE_TTL=60
REDIS_PUBSUB_CHANNEL=skillswap:events

# =============================================================================
# 5. OAuth 2.0 Providers
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Local:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Production (Render backend URL callback):
# GOOGLE_REDIRECT_URI=https://skillswap-backend-qc37.onrender.com/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Local:
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Production (Render backend URL callback):
# GITHUB_REDIRECT_URI=https://skillswap-backend-qc37.onrender.com/auth/github/callback

# =============================================================================
# 6. AI & Gemini
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
