APP_NAME=SkillSwap Arena

DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillswap
DB_USER=postgres
DB_PASSWORD=password

JWT_SECRET=replace_me

# AI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embedding Engine (Day 69)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30
EMBEDDING_CONCURRENCY=5
EMBEDDING_VERSION=1

# RAG Context Builder (Day 72 A1)
RAG_MAX_CONTEXT_CHUNKS=10
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MAX_CONTEXT_TOKENS=3000

# RAG Prompt Builder / Generation (Day 72 A2)
RAG_MAX_PROMPT_TOKENS=4000
RAG_TEMPERATURE=0.2
RAG_MAX_OUTPUT_TOKENS=1024
RAG_RESPONSE_STYLE=detailed