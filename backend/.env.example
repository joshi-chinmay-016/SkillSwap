# SkillSwap Arena — Backend Environment Configuration Example

APP_NAME=SkillSwap Arena
ENVIRONMENT=development

# =============================================================================
# 1. Database Configuration (PostgreSQL / Supabase)
# =============================================================================
# Local:
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillswap
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillswap
DB_USER=postgres
DB_PASSWORD=password

# Production (Render / Supabase Session Pooler):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# =============================================================================
# 2. Security & JWT
# =============================================================================
SECRET_KEY=replace_with_strong_production_secret_key_minimum_32_characters
JWT_SECRET=replace_with_strong_production_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# 3. CORS & URLs
# =============================================================================
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Production (Set on Render dashboard):
# CORS_ORIGINS=https://<your-vercel-domain>.vercel.app
# FRONTEND_URL=https://<your-vercel-domain>.vercel.app
# FRONTEND_AUTH_CALLBACK_URL=https://<your-vercel-domain>.vercel.app/auth/callback

# =============================================================================
# 4. Redis Infrastructure (Render Redis / Upstash)
# =============================================================================
# Local:
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_CACHE_DEFAULT_TTL=300
REDIS_PRESENCE_TTL=60
REDIS_PUBSUB_CHANNEL=skillswap:events

# Production (Render Redis instance):
# REDIS_URL=rediss://default:<password>@<host>:<port>

# =============================================================================
# 5. OAuth 2.0 Providers (Google & GitHub)
# =============================================================================
# Google OAuth:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Local:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Production (Render backend URL callback endpoint):
# GOOGLE_REDIRECT_URI=https://skillswap-backend-qc37.onrender.com/auth/google/callback

# GitHub OAuth:
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Local:
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Production (Render backend URL callback endpoint):
# GITHUB_REDIRECT_URI=https://skillswap-backend-qc37.onrender.com/auth/github/callback

# =============================================================================
# 6. AI & Embeddings / Gemini
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embedding Engine (Day 69)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30
EMBEDDING_CONCURRENCY=5
EMBEDDING_VERSION=1

# =============================================================================
# 7. RAG & Vector Store Configuration
# =============================================================================
FAISS_INDEX_DIR=vector_store
FAISS_INDEX_FILENAME=skillswap.index
FAISS_MAPPING_FILENAME=skillswap_mapping.json
FAISS_EMBEDDING_DIMENSION=768

RAG_MAX_CONTEXT_CHUNKS=10
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_PROMPT_TOKENS=4000
RAG_TEMPERATURE=0.2
RAG_MAX_OUTPUT_TOKENS=1024
RAG_RESPONSE_STYLE=detailed